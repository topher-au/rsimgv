<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="RsimgvWindow" parent="AdwApplicationWindow">
    <property name="default-width">960</property>
    <property name="default-height">640</property>
    <property name="title">rsimgv</property>
    <property name="content">
      <object class="RsimgvOverlaySplitView" id="split">
        <child type="sidebar">
          <object class="AdwToolbarView">
            <child type="top">
              <object class="AdwHeaderBar">
                <property name="show-start-title-buttons">false</property>
                <property name="show-end-title-buttons">false</property>
                <child type="start">
                  <object class="GtkToggleButton" id="sidebar_header_toggle">
                    <property name="icon-name">sidebar-show-symbolic</property>
                    <property name="tooltip-text">Hide sidebar</property>
                    <property name="active">true</property>
                    <style><class name="flat"/></style>
                  </object>
                </child>
                <child type="title">
                  <object class="AdwWindowTitle">
                    <property name="title">rsimgv</property>
                  </object>
                </child>
              </object>
            </child>
            <property name="content">
              <object class="RsimgvFsTree" id="tree"/>
            </property>
          </object>
        </child>
        <child type="content">
          <object class="AdwToolbarView">
            <child type="top">
              <object class="RsimgvHeaderBar" id="content_header">
                <child type="start">
                  <object class="GtkRevealer" id="content_revealer">
                    <property name="transition-type">slide-right</property>
                    <child>
                      <object class="GtkToggleButton" id="content_sidebar_toggle">
                        <property name="icon-name">sidebar-show-symbolic</property>
                        <property name="tooltip-text">Show sidebar</property>
                        <property name="margin-end">4</property>
                        <style><class name="flat"/></style>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="title">
                  <object class="GtkBox" id="toolbar_box">
                    <property name="spacing">4</property>
                    <property name="hexpand">true</property>
                    <child>
                      <object class="RsimgvNavigationBar" id="navigation"/>
                    </child>
                    <child>
                      <object class="GtkStack" id="title_stack">
                        <property name="hexpand">true</property>
                        <child>
                          <object class="RsimgvPathBar" id="path_bar">
                            <property name="hexpand">true</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="location_entry">
                            <property name="hexpand">true</property>
                            <property name="placeholder-text">Type a folder path</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  <child type="end">
                    <object class="GtkMenuButton" id="menu_button">
                      <property name="icon-name">open-menu-symbolic</property>
                      <property name="tooltip-text">Main menu</property>
                      <style><class name="flat"/></style>
                      <property name="menu-model">
                        <menu id="main-menu">
                          <section>
                            <item>
                              <attribute name="label">Show Hidden Directories</attribute>
                              <attribute name="action">win.show-hidden</attribute>
                            </item>
                          </section>
                          <section>
                            <item>
                              <attribute name="label">Preferences</attribute>
                              <attribute name="action">app.preferences</attribute>
                            </item>
                          </section>
                          <section>
                            <item>
                              <attribute name="label">Quit</attribute>
                              <attribute name="action">app.quit</attribute>
                            </item>
                          </section>
                        </menu>
                      </property>
                    </object>
                    </child>
                    <child>
                      <object class="GtkWindowControls" id="controls">
                        <property name="side">end</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <property name="content">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwTabBar" id="tab_bar">
                    <property name="view">tab_view</property>
                    <property name="autohide">true</property>
                    <property name="expand-tabs">false</property>
                  </object>
                </child>
                <property name="content">
                  <object class="AdwTabView" id="tab_view"/>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
  </template>
</interface>
