<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="RsimgvWindow" parent="AdwApplicationWindow">
    <property name="default-width">960</property>
    <property name="default-height">640</property>
    <property name="title">rsimgv</property>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 800px</condition>
        <setter object="playlist_split" property="collapsed">True</setter>
      </object>
    </child>
    <property name="content">
      <object class="GtkOverlay" id="message_layer">
        <property name="child">
      <object class="GtkStack" id="pages">
        <child>
          <object class="RsimgvOverlaySplitView" id="split">
        <child type="sidebar">
          <object class="AdwToolbarView">
            <child type="top">
              <object class="AdwHeaderBar">
                <property name="show-start-title-buttons">false</property>
                <property name="show-end-title-buttons">false</property>
                <child type="start">
                  <object class="GtkToggleButton" id="sidebar_header_toggle">
                    <property name="icon-name">sidebar-show-symbolic</property>
                    <property name="tooltip-text">Hide sidebar</property>
                    <property name="active">true</property>
                    <style><class name="flat"/></style>
                  </object>
                </child>
                <child type="title">
                  <object class="AdwWindowTitle">
                    <property name="title">rsimgv</property>
                  </object>
                </child>
              </object>
            </child>
            <property name="content">
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkExpander" id="bookmarks_expander">
                    <property name="expanded">true</property>
                    <style><class name="rsimgv-sidebar-section"/></style>
                    <property name="label-widget">
                      <object class="GtkBox">
                        <property name="spacing">2</property>
                        <property name="hexpand">true</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Bookmarks</property>
                            <property name="hexpand">true</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="caption-heading"/>
                              <class name="dimmed"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton">
                            <property name="icon-name">bookmark-new-symbolic</property>
                            <property name="tooltip-text">Bookmark this folder</property>
                            <property name="action-name">win.bookmark-folder</property>
                            <property name="focus-on-click">false</property>
                            <style>
                              <class name="flat"/>
                              <class name="rsimgv-sidebar-section-button"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="child">
                      <!-- A long list scrolls, so that it cannot push the folder tree out of the sidebar. -->
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="propagate-natural-height">true</property>
                        <property name="max-content-height">240</property>
                        <property name="child">
                          <object class="GtkListBox" id="bookmarks_list">
                            <property name="selection-mode">single</property>
                            <style>
                              <class name="navigation-sidebar"/>
                              <class name="rsimgv-bookmarks"/>
                            </style>
                            <child type="placeholder">
                              <object class="GtkLabel">
                                <property name="label">No bookmarks yet</property>
                                <property name="margin-top">4</property>
                                <property name="margin-bottom">8</property>
                                <style>
                                  <class name="caption"/>
                                  <class name="dimmed"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkExpander" id="filesystem_expander">
                    <property name="expanded">true</property>
                    <style><class name="rsimgv-sidebar-section"/></style>
                    <property name="label-widget">
                      <object class="GtkBox">
                        <property name="spacing">2</property>
                        <property name="hexpand">true</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label">Filesystem</property>
                            <property name="hexpand">true</property>
                            <property name="xalign">0</property>
                            <style>
                              <class name="caption-heading"/>
                              <class name="dimmed"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkToggleButton" id="filesystem_root_button">
                            <property name="icon-name">drive-harddisk-symbolic</property>
                            <property name="tooltip-text">Root the tree at the filesystem root</property>
                            <property name="focus-on-click">false</property>
                            <style>
                              <class name="flat"/>
                              <class name="rsimgv-sidebar-section-button"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkToggleButton" id="filesystem_home_button">
                            <property name="icon-name">user-home-symbolic</property>
                            <property name="tooltip-text">Root the tree at the home folder</property>
                            <property name="focus-on-click">false</property>
                            <property name="group">filesystem_root_button</property>
                            <style>
                              <class name="flat"/>
                              <class name="rsimgv-sidebar-section-button"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="child">
                      <object class="RsimgvFsTree" id="tree">
                        <property name="vexpand">true</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
        <child type="content">
          <object class="AdwToolbarView">
            <style><class name="content-pane"/></style>
            <child type="top">
              <object class="RsimgvHeaderBar" id="content_header">
                <child type="start">
                  <object class="GtkRevealer" id="content_revealer">
                    <property name="transition-type">slide-right</property>
                    <child>
                      <object class="GtkToggleButton" id="content_sidebar_toggle">
                        <property name="icon-name">sidebar-show-symbolic</property>
                        <property name="tooltip-text">Show sidebar</property>
                        <property name="margin-end">4</property>
                        <style><class name="flat"/></style>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="title">
                  <object class="GtkBox" id="toolbar_box">
                    <property name="spacing">4</property>
                    <property name="hexpand">true</property>
                    <child>
                      <object class="RsimgvNavigationBar" id="navigation"/>
                    </child>
                    <child>
                      <object class="GtkStack" id="title_stack">
                        <property name="hexpand">true</property>
                        <child>
                          <object class="RsimgvPathBar" id="path_bar">
                            <property name="hexpand">true</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkEntry" id="location_entry">
                            <property name="hexpand">true</property>
                            <property name="placeholder-text">Type a folder path</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  <child>
                    <object class="GtkMenuButton" id="sort_button">
                      <property name="icon-name">view-sort-symbolic</property>
                      <property name="tooltip-text">Sort and view options</property>
                      <style><class name="flat"/></style>
                      <property name="menu-model">
                        <menu id="sort-menu">
                          <section>
                            <item>
                              <attribute name="label">Alphabetical</attribute>
                              <attribute name="action">win.sort-by</attribute>
                              <attribute name="target">name</attribute>
                            </item>
                            <item>
                              <attribute name="label">Modification Time</attribute>
                              <attribute name="action">win.sort-by</attribute>
                              <attribute name="target">modified</attribute>
                            </item>
                            <item>
                              <attribute name="label">Size</attribute>
                              <attribute name="action">win.sort-by</attribute>
                              <attribute name="target">size</attribute>
                            </item>
                            <item>
                              <attribute name="label">Type</attribute>
                              <attribute name="action">win.sort-by</attribute>
                              <attribute name="target">type</attribute>
                            </item>
                          </section>
                          <section>
                            <item>
                              <attribute name="label">Ascending</attribute>
                              <attribute name="action">win.sort-order</attribute>
                              <attribute name="target">ascending</attribute>
                            </item>
                            <item>
                              <attribute name="label">Descending</attribute>
                              <attribute name="action">win.sort-order</attribute>
                              <attribute name="target">descending</attribute>
                            </item>
                          </section>
                          <section>
                            <item>
                              <attribute name="label">Show Hidden Files</attribute>
                              <attribute name="action">win.show-hidden</attribute>
                            </item>
                            <item>
                              <attribute name="label">Show Directories</attribute>
                              <attribute name="action">win.show-directories</attribute>
                            </item>
                          </section>
                        </menu>
                      </property>
                    </object>
                  </child>
                  <child type="end">
                    <object class="GtkMenuButton" id="menu_button">
                      <property name="icon-name">open-menu-symbolic</property>
                      <property name="tooltip-text">Main menu</property>
                      <style><class name="flat"/></style>
                      <property name="menu-model">
                        <menu id="main-menu">
                          <section>
                            <item>
                              <attribute name="label">Show Hidden Directories</attribute>
                              <attribute name="action">win.show-hidden</attribute>
                            </item>
                          </section>
                          <section>
                            <item>
                              <attribute name="label">Detach Playlist</attribute>
                              <attribute name="action">win.playlist-detach</attribute>
                            </item>
                          </section>
                          <section>
                            <item>
                              <attribute name="label">Preferences</attribute>
                              <attribute name="action">app.preferences</attribute>
                            </item>
                          </section>
                          <section>
                            <item>
                              <attribute name="label">Quit</attribute>
                              <attribute name="action">app.quit</attribute>
                            </item>
                          </section>
                        </menu>
                      </property>
                    </object>
                    </child>
                    <child>
                      <object class="GtkWindowControls" id="controls">
                        <property name="side">end</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <property name="content">
              <!-- The playlist is a sidebar below the header, on the opposite side from the browse split's. -->
              <object class="RsimgvOverlaySplitView" id="playlist_split">
                <child type="content">
                  <object class="AdwToolbarView">
                <property name="hexpand">true</property>
                <child type="bottom">
                  <object class="AdwTabBar" id="tab_bar">
                    <property name="view">tab_view</property>
                    <property name="autohide">true</property>
                    <property name="expand-tabs">false</property>
                  </object>
                </child>
                <property name="content">
                  <object class="AdwTabView" id="tab_view"/>
                </property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>
          </object>
        </child>
        <child>
          <object class="RsimgvMediaViewer" id="viewer"/>
        </child>
      </object>
        </property>
      </object>
    </property>
  </template>
</interface>
