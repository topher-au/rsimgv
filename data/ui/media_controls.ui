<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="RsimgvMediaControls" parent="GtkBox">
    <property name="orientation">horizontal</property>
    <property name="spacing">4</property>
    <property name="margin-top">8</property>
    <property name="margin-bottom">8</property>
    <property name="margin-start">8</property>
    <property name="margin-end">8</property>
    <style><class name="osd"/><class name="media-controls"/></style>
    <child>
      <object class="GtkButton" id="previous_button">
        <property name="icon-name">media-skip-backward-symbolic</property>
        <property name="tooltip-text">Previous</property>
        <style><class name="flat"/></style>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="rewind_button">
        <property name="icon-name">media-seek-backward-symbolic</property>
        <property name="tooltip-text">Rewind 5 seconds</property>
        <style><class name="flat"/></style>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="play_button">
        <property name="icon-name">media-playback-start-symbolic</property>
        <property name="tooltip-text">Play</property>
        <style><class name="flat"/></style>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="forward_button">
        <property name="icon-name">media-seek-forward-symbolic</property>
        <property name="tooltip-text">Fast forward 5 seconds</property>
        <style><class name="flat"/></style>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="next_button">
        <property name="icon-name">media-skip-forward-symbolic</property>
        <property name="tooltip-text">Next</property>
        <style><class name="flat"/></style>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="time_label">
        <property name="margin-start">8</property>
        <property name="margin-end">8</property>
        <style><class name="numeric"/></style>
      </object>
    </child>
    <child>
      <object class="GtkScale" id="position">
        <property name="orientation">horizontal</property>
        <property name="draw-value">false</property>
        <property name="hexpand">true</property>
        <property name="width-request">240</property>
        <property name="valign">center</property>
      </object>
    </child>
    <child>
      <object class="GtkOverlay" id="volume_overlay">
        <property name="valign">center</property>
        <child>
          <object class="GtkButton" id="volume_button">
            <property name="icon-name">audio-volume-high-symbolic</property>
            <property name="tooltip-text">Mute</property>
            <style><class name="flat"/></style>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkRevealer" id="volume_revealer">
            <property name="valign">end</property>
            <property name="halign">center</property>
            <property name="margin-bottom">40</property>
            <property name="transition-type">crossfade</property>
            <child>
              <object class="GtkBox" id="volume_slider_box">
                <style><class name="osd"/></style>
                <property name="margin-top">8</property>
                <property name="margin-bottom">8</property>
                <property name="margin-start">8</property>
                <property name="margin-end">8</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
