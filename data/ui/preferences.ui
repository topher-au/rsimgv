<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="RsimgvPreferencesDialog" parent="AdwPreferencesDialog">
    <property name="content-width">760</property>
    <child>
      <object class="AdwPreferencesPage">
        <property name="title">General</property>
        <property name="icon-name">preferences-system-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwComboRow" id="start_location_row">
                <property name="title">Start location</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item>Last open directory</item>
                      <item>Root directory</item>
                      <item>Home directory</item>
                      <item>Specific directory</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow" id="start_directory_row">
                <property name="title">Start directory</property>
                <child type="suffix">
                  <object class="GtkButton" id="start_directory_button">
                    <property name="icon-name">folder-open-symbolic</property>
                    <property name="tooltip-text">Choose Folder</property>
                    <property name="valign">center</property>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="open_fullscreen_row">
                <property name="title">Open in fullscreen</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="ipc_socket_row">
                <property name="title">Control rsimgv through a Unix socket</property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="ipc_tcp_row">
                <property name="title">TCP port for control</property>
                <property name="subtitle">0 turns it off.</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">0</property>
                    <property name="upper">65535</property>
                    <property name="step-increment">1</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="ipc_http_row">
                <property name="title">HTTP port for control</property>
                <property name="subtitle">0 turns it off.</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">0</property>
                    <property name="upper">65535</property>
                    <property name="step-increment">1</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="ipc_external_row">
                <property name="title">Allow other machines to control rsimgv</property>
                <property name="subtitle">Applies to the TCP and HTTP ports, which otherwise accept only localhost. Anyone who can reach them can control rsimgv.</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="auto_hide_cursor_row">
                <property name="title">Auto hide cursor</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="smooth_scrolling_row">
                <property name="title">Smooth scrolling</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="image_info_in_title_row">
                <property name="title">Image info in window title</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="zoom_indicator_row">
                <property name="title">Zoom indicator</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item>On</item>
                      <item>Off</item>
                      <item>Auto</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="collapse_on_navigate_row">
                <property name="title">Collapse other folders when navigating</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage">
        <property name="title">Browsing</property>
        <property name="icon-name">folder-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Items</property>
            <child>
              <object class="AdwSpinRow" id="item_size_row">
                <property name="title">Item size</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">32</property>
                    <property name="upper">2048</property>
                    <property name="step-increment">16</property>
                    <property name="value">128</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="filename_row">
                <property name="title">Show filename</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item>Off</item>
                      <item>Wrapped</item>
                      <item>Ellipsized</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Show info</property>
            <property name="description">Details shown under each item's name, in this order</property>
            <child>
              <object class="GtkListBox" id="info_list">
                <property name="selection-mode">none</property>
                <style><class name="boxed-list"/></style>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">horizontal</property>
                <property name="spacing">6</property>
                <property name="margin-top">6</property>
                <child>
                  <object class="GtkMenuButton" id="add_info_button">
                    <property name="label">Add item</property>
                  </object>
                </child>
                <child>
                  <object class="GtkDropDown" id="info_layout_dropdown">
                    <property name="hexpand">true</property>
                    <property name="halign">end</property>
                    <property name="model">
                      <object class="GtkStringList">
                        <items>
                          <item>Disabled</item>
                          <item>Stacked</item>
                          <item>Inline</item>
                        </items>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Visible files</property>
            <child>
              <object class="AdwComboRow" id="show_directories_row">
                <property name="title">Show directories</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item>None</item>
                      <item>First/Last</item>
                      <item>Inline</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="show_hidden_row">
                <property name="title">Show hidden files and folders</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="media_only_row">
                <property name="title">Only show compatible media files</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage">
        <property name="title">View</property>
        <property name="icon-name">view-grid-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Fit and Zoom</property>
            <child>
              <object class="AdwComboRow" id="image_fit_row">
                <property name="title">Image fit</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item>Fit to window</item>
                      <item>Stretch to width</item>
                      <item>1:1</item>
                      <item>Fit to window (stretch)</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="keep_fit_mode_row">
                <property name="title">Keep fit mode when switching images</property>
                <property name="subtitle">Otherwise each image fits the window. Zoom is always reset.</property>
              </object>
            </child>
            <child>
              <object class="AdwSpinRow" id="zoom_step_row">
                <property name="title">Zoom step</property>
                <property name="subtitle">How much, in percent, each zoom in or out changes the size</property>
                <property name="adjustment">
                  <object class="GtkAdjustment">
                    <property name="lower">5</property>
                    <property name="upper">100</property>
                    <property name="step-increment">5</property>
                    <property name="page-increment">25</property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <property name="title">Expand images up to</property>
                <property name="subtitle">The most that fitting to the window enlarges small images</property>
                <child type="suffix">
                  <object class="GtkScale" id="expand_up_to_scale">
                    <property name="orientation">horizontal</property>
                    <property name="width-request">200</property>
                    <property name="valign">center</property>
                    <property name="draw-value">true</property>
                    <property name="value-pos">left</property>
                    <property name="digits">0</property>
                    <property name="round-digits">0</property>
                    <property name="adjustment">
                      <object class="GtkAdjustment">
                        <property name="lower">0</property>
                        <property name="upper">4</property>
                        <property name="step-increment">1</property>
                        <property name="page-increment">1</property>
                        <property name="value">0</property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Appearance</property>
            <child>
              <object class="AdwSwitchRow" id="blurred_background_row">
                <property name="title">Blurred background behind images</property>
                <property name="subtitle">A zoomed, cropped, dimmed and blurred copy of the picture fills the viewer behind it.</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Thumbnail Bar</property>
            <child>
              <object class="AdwSwitchRow" id="thumbnail_bar_shown_row">
                <property name="title">Show thumbnail bar</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="thumbnail_bar_row">
                <property name="title">Position</property>
                <property name="subtitle">You can also drag the bar to any edge of the viewer.</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item>Top</item>
                      <item>Left</item>
                      <item>Bottom</item>
                      <item>Right</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Video</property>
            <child>
              <object class="AdwComboRow" id="video_backend_row">
                <property name="title">Player</property>
                <property name="subtitle">Applies to the next video opened</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item>mpv</item>
                      <item>GTK</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="mpv_args_row">
                <property name="title">mpv options</property>
                <property name="show-apply-button">true</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Scaling</property>
            <child>
              <object class="AdwComboRow" id="scaling_filter_row">
                <property name="title">Filter</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item>Nearest</item>
                      <item>Bilinear</item>
                      <item>Bicubic</item>
                      <item>Lanczos</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="smooth_upscaling_row">
                <property name="title">Smooth upscaling</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesPage" id="keybindings_page">
        <property name="name">keybindings</property>
        <property name="title">Keybindings</property>
        <property name="icon-name">input-keyboard-symbolic</property>
      </object>
    </child>
  </template>
</interface>
