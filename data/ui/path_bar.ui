<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="RsimgvPathBar" parent="GtkBox">
    <property name="orientation">horizontal</property>
    <child>
      <object class="GtkScrolledWindow" id="scroller">
        <property name="hscrollbar-policy">external</property>
        <property name="vscrollbar-policy">never</property>
        <property name="hexpand">true</property>
        <property name="child">
          <object class="GtkBox" id="segments"/>
        </property>
      </object>
    </child>
    <child>
      <object class="GtkMenuButton" id="current_view_menu_button">
        <property name="icon-name">view-more-symbolic</property>
        <property name="tooltip-text">Current Folder Menu</property>
        <style><class name="flat"/></style>
      </object>
    </child>
  </template>
</interface>
